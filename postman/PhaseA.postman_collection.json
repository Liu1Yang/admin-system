{
  "info": {
    "_postman_id": "admin-system-phase-a-day20",
    "name": "admin-system 阶段A联调 (Day9-19)",
    "description": "阶段 A 全链路联调：RBAC + 分类 + 商品 + 登出黑名单。\n\n前置：依次执行 sql/init.sql → update-password-bcrypt.sql → rbac.sql → category.sql → product.sql\n\n业务错误 HTTP 仍为 200，看 body.code。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "tempProductId", "value": "" },
    { "key": "tempCategoryId", "value": "" }
  ],
  "item": [
    {
      "name": "1-认证",
      "item": [
        {
          "name": "admin 登录",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var res = pm.response.json();",
                "pm.test('code=200', () => pm.expect(res.code).to.eql(200));",
                "pm.collectionVariables.set('adminToken', res.data.token);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "GET /me（含 roles + permissions）",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json().data;",
                "pm.test('有权限列表', () => pm.expect(d.permissions.length).to.be.at.least(1));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "2-分类",
      "item": [
        {
          "name": "GET 分类树",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('code=200', () => pm.expect(pm.response.json().code).to.eql(200));"], "type": "text/javascript" }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/categories/tree"
          }
        },
        {
          "name": "POST 新增叶子分类",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var res = pm.response.json();",
                "pm.test('code=200', () => pm.expect(res.code).to.eql(200));",
                "pm.collectionVariables.set('tempCategoryId', res.data.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"联调测试分类\",\n  \"parentId\": 4,\n  \"sort\": 99\n}" },
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "DELETE 删除测试分类",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/categories/{{tempCategoryId}}"
          }
        }
      ]
    },
    {
      "name": "3-商品",
      "item": [
        {
          "name": "GET 分页搜索（name=iPhone）",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('code=200', () => pm.expect(pm.response.json().code).to.eql(200));"], "type": "text/javascript" }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/products?page=1&size=10&name=iPhone&status=1"
          }
        },
        {
          "name": "POST 新建商品",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var res = pm.response.json();",
                "pm.test('默认下架 status=0', () => pm.expect(res.data.status).to.eql(0));",
                "pm.collectionVariables.set('tempProductId', res.data.id);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"联调测试商品\",\n  \"categoryId\": 2,\n  \"price\": 1999.00,\n  \"stock\": 10,\n  \"description\": \"Day20 联调\"\n}" },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "GET 商品详情（触发 Redis 缓存）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/products/{{tempProductId}}"
          }
        },
        {
          "name": "PUT 上架",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('status=1', () => pm.expect(pm.response.json().data.status).to.eql(1));"], "type": "text/javascript" }
          }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": 1\n}" },
            "url": "{{baseUrl}}/api/products/{{tempProductId}}/status"
          }
        },
        {
          "name": "PUT 库存为0上架 → 400",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('code=400', () => pm.expect(pm.response.json().code).to.eql(400));"], "type": "text/javascript" }
          }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 0\n}" },
            "url": "{{baseUrl}}/api/products/{{tempProductId}}"
          }
        },
        {
          "name": "DELETE 删除测试商品",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/products/{{tempProductId}}"
          }
        }
      ]
    },
    {
      "name": "4-登出黑名单",
      "item": [
        {
          "name": "admin 重新登录",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().data.token);"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST 登出",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "登出后再访问 /me → 401",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('code=401', () => pm.expect(pm.response.json().code).to.eql(401));"], "type": "text/javascript" }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    }
  ]
}
